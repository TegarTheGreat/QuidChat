{
  "name": "@quidchat/cli",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.22.3"
  },
  "bin": {
    "quidchat": "./dist/main.mjs"
  },
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "build": "tsdown src/main.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@electric-sql/pglite": "0.5.4",
    "@electric-sql/pglite-pgvector": "0.0.5",
    "drizzle-orm": "0.45.2",
    "postgres": "3.4.9"
  },
  "files": [
    "dist"
  ],
  "devDependencies": {
    "@quidchat/db": "workspace:*",
    "@quidchat/providers": "workspace:*",
    "@quidchat/server": "workspace:*"
  }
}
