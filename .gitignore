# =============================================================
#  QuidChat — .gitignore
# =============================================================

# -------------------------------------------------------------
#  Claude Code / Claude — never commit
# -------------------------------------------------------------
.claude/
.claude*
CLAUDE.md
CLAUDE.local.md
**/CLAUDE.md
**/.claude/
.mcp.json
.anthropic/
anthropic.json
.remember/
.superpowers/
.agent/
.agents/
AGENTS.md
**/AGENTS.md
GEMINI.md
.cursor/
.cursorrules
.windsurfrules
.aider*
.continue/
.codeium/
.github/copilot-instructions.md

# -------------------------------------------------------------
#  Secrets and credentials — never, ever commit
# -------------------------------------------------------------
# Env
.env
.env.*
!.env.example
!.env.sample
*.env
env.sh

# Keys and certificates
*.pem
*.key
*.p12
*.pfx
*.jks
*.keystore
*.crt
*.cer
*.der
*.asc
*.gpg
*.kdbx
id_rsa*
id_dsa*
id_ecdsa*
id_ed25519*
*.ppk
known_hosts
authorized_keys

# Cloud and service credentials
credentials
credentials.json
client_secret*.json
service-account*.json
*-serviceaccount.json
gha-creds-*.json
.aws/
.azure/
.gcloud/
gcloud-key*.json
.netrc
_netrc
.npmrc
!/.npmrc
.yarnrc
.pypirc
.dockercfg
.docker/config.json
.kube/config
kubeconfig*
*.tfvars
!*.tfvars.example
.terraform/
terraform.tfstate*
.vault-token
.pgpass

# Common secret directories and patterns
secrets/
secret/
private/
.secrets/
*secret*.json
*secret*.yaml
*secret*.yml
*token*.json
*apikey*
*api_key*
*.secrets.*

# -------------------------------------------------------------
#  Local QuidChat data (embedded DB, indexes, cache)
# -------------------------------------------------------------
# NOTE: directories in this block are anchored with a leading "/" so they only
# match at the repo root. Without it, a pattern like `models/` would also ignore
# `src/models/`, and `memory/` would ignore `src/memory/` — source code would
# disappear from git with no warning at all.

# PGlite / embedded-postgres
/.quidchat/
/data/
/pgdata/
/pglite-data/
*.pgdata

# SQLite (if used for cache or dev)
*.db
*.db-journal
*.db-wal
*.db-shm
*.sqlite
*.sqlite3

# Vector indexes and model artefacts
*.bin
*.gguf
*.safetensors
*.onnx
*.pt
*.pth
/models/
/embeddings/
/.vectors/
/.index/

# Conversation transcripts and memory (may contain personal data)
/sessions/
/transcripts/
/conversations/
/memory/
/.memory/

# -------------------------------------------------------------
#  Node / TypeScript
# -------------------------------------------------------------
node_modules/
.pnpm-store/
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/releases
dist/
build/
out/
# `lib/` is deliberately NOT listed — that pattern would also ignore `src/lib/`,
# a very common source convention in TypeScript projects. `dist/` and `build/`
# already cover build output.
*.tsbuildinfo
.tshy/
.rollup.cache/
.turbo/
.next/
.nuxt/
.svelte-kit/
.astro/
.vite/
coverage/
.nyc_output/
*.lcov
.eslintcache
.oxlintcache
.stylelintcache
storybook-static/
playwright-report/
test-results/
blob-report/
.vitest/

# -------------------------------------------------------------
#  Python (in case of an ML sidecar)
# -------------------------------------------------------------
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
env/
.python-version
.pytest_cache/
.mypy_cache/
.ruff_cache/
.ipynb_checkpoints/

# -------------------------------------------------------------
#  Editor and OS
# -------------------------------------------------------------
.vscode/
!.vscode/extensions.json
.idea/
*.iml
*.swp
*.swo
*~
\#*\#
.\#*
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/

# -------------------------------------------------------------
#  Brainstorming session artefacts (visual mockups)
# -------------------------------------------------------------
.superpowers/

# -------------------------------------------------------------
#  Logs, temp files, archives
# -------------------------------------------------------------
*.log
logs/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*
tmp/
temp/
.tmp/
.cache/
*.tmp
*.bak
*.orig
*.rej
*.pid
*.seed
*.tgz
*.zip
*.tar
*.tar.gz
*.7z
*.rar
# Unix core dumps — deliberately anchored and narrowed. A bare `core` pattern
# matches a DIRECTORY named `core` at any level, so `packages/core/` and
# everything in it would be ignored with no warning.
/core
core.[0-9]*

# -------------------------------------------------------------
#  Never ignore lockfiles — they matter for supply chain integrity
# -------------------------------------------------------------
!pnpm-lock.yaml
!package-lock.json
!yarn.lock
!uv.lock
